DATABASE_URL='postgres://user:password@host/dbname?sslmode=require' # postgres url, i use neon database
JWT_SECRET='your-super-secret-key-here' # secret used to sign JWT tokens
RESEND_KEY='re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' # api key from resend.com
MAIL_FROM='noreply@yourdomain.com' # sender address, must be verified on Resend
REDIS='redis://default:password@host:6379' # redis connection url
APP_ENV='development' # development | production
